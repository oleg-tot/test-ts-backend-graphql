generator client {
  provider     = "prisma-client"
  output       = "../../src/generated/prisma"
  moduleFormat = "esm"
  runtime      = "nodejs"
}

generator nestgraphql {
  provider           = "prisma-nestjs-graphql"
  output             = "../../src/@generated"
  importExtension    = "js"
  prismaClientImport = "../../generated/prisma/client.js"
  reExport           = Single
}

datasource db {
  provider = "postgresql"
}
