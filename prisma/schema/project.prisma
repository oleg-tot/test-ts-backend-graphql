model Project {
  id            String    @id @default(cuid())
  profileId     String
  name          String
  description   String?
  url           String?
  repositoryUrl String?
  startDate     DateTime?
  endDate       DateTime?
  featured      Boolean   @default(false)
  order         Int       @default(0)
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills        Skill[]

  @@index([profileId])
}
